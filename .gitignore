# OS
.DS_Store

# Editors
.idea/
.vscode/

# Python (tools/, src/)
__pycache__/
*.py[cod]
.venv/
venv/

# Packaging artefacts (src/ocn/data/ IS tracked — it ships in the wheel)
*.egg-info/
/dist/

# Rust (rust/data/ IS tracked — the crate embeds it with include_str!)
/rust/target/


# Local data caches (we may keep them out of the repo)
/build
/out
*.parquet

# Derived release artefact — built by tools/build_json_export.py, attached
# to releases, never committed (canonical source is catalog/ocn-1.csv)
/ocn-1.json

# Web explorer output — rebuilt by `python3 web/build.py` from the
# catalogue; the sources (index.html, app.js, style.css) ARE tracked
web/dist/

# Upstream data — fetched by tools/fetch_lichess.sh, not vendored

# Local agent context — never tracked
.wolf/
.claude/

# Local credentials for the maintenance tools (Lichess explorer API,
# crates.io publishing). Never committed: this repo is public.
.env
.env.local
